#!/usr/bin/env bash
# asahi-hud <field>  one-line values for MangoHud exec= lines; static fields are cached per game process
game=$(awk '{print $4}' /proc/$PPID/stat 2>/dev/null)
cache="${XDG_RUNTIME_DIR:-/tmp}/asahi-hud"

pkg_of() {
    case "$1" in
        /usr/*) rpm -qf "$1" --qf '%{NAME} %{VERSION} %{RELEASE}\n' 2>/dev/null | head -1 |
                sed -E 's/\.fc[0-9]+//' | sed -E 's/^[^ ]*-git(-core)? [^ ]*git\.([0-9a-f]+) (.*)/git \2 · \3/; t; s/^[^ ]+ ([^ ]+) (.*)/\1 · \2/' ;;
        "") echo "?" ;;
        *) echo "overlay ${1%%/lib64/*}" | sed "s|$HOME|~|" ;;
    esac
}

static() {
    case "$1" in
        wine) pkg_of "$(readlink -f /proc/$game/exe | sed 's|/wine-preloader$|/wine|')" ;;
        fex) pkg_of "$(grep -m1 -oE '/[^ ]*lib(arm64ec|wow64)fex\.so' /proc/$game/maps)" ;;
        machine) tr -d '\0' < /proc/device-tree/model | sed -E 's/^Apple //; s/^MacBook Pro/MBP/; s/^MacBook Air/MBA/; s/\(([0-9]+)-inch, /\1" /; s/, [0-9]{4}\)//' ;;
        kernel) uname -r | sed -E 's/\.fc[0-9]+\.aarch64//' ;;
        pages) echo "$(( $(getconf PAGESIZE) / 1024 ))K host / 4K guest" ;;
        mesa) rpm -q mesa-vulkan-drivers --qf '%{VERSION}\n' ;;
        dxvk) rpm -q wine-dxvk --qf '%{VERSION}\n' 2>/dev/null || echo "-" ;;
    esac
}

case "$1" in
    wine|fex|kernel|pages|mesa|dxvk|machine)
        mkdir -p "$cache"
        f="$cache/$game.$1"
        [ -s "$f" ] || static "$1" > "$f"
        cat "$f"
        find "$cache" -type f -mmin +720 -delete 2>/dev/null ;;
    clusters)
        e=$(( $(cat /sys/devices/system/cpu/cpufreq/policy0/scaling_cur_freq) / 1000 ))
        p1=$(( $(cat /sys/devices/system/cpu/cpufreq/policy4/scaling_cur_freq) / 1000 ))
        p2=$(( $(cat /sys/devices/system/cpu/cpufreq/policy8/scaling_cur_freq 2>/dev/null || echo 0) / 1000 ))
        [ "$p2" -gt 0 ] && echo "${e} · ${p1} · ${p2} MHz" || echo "${e} · ${p1} MHz" ;;
    mem)
        awk '/^VmRSS/ {printf "%.2f GiB", $2 / 1048576}' /proc/$game/status ;;
    gpumem)
        awk '/\/dev\/dri\/renderD/ {split($1, a, "-"); s += strtonum("0x" a[2]) - strtonum("0x" a[1])} END {printf "%.2f GiB", s / 1073741824}' /proc/$game/maps ;;
    power)
        h=$(grep -l '^macsmc_hwmon$' /sys/class/hwmon/*/name | head -1); h=${h%/name}
        awk '{printf "%.1f W", $1 / 1e6}' "$h/power1_input" ;;
    fans)
        h=$(grep -l '^macsmc_hwmon$' /sys/class/hwmon/*/name | head -1); h=${h%/name}
        echo "$(cat "$h"/fan*_input 2>/dev/null | tr '\n' ' ' | sed 's/ $//; s/ / \/ /g') rpm" ;;
    battery)
        b=/sys/class/power_supply/macsmc-battery
        echo "$(cat $b/capacity)% $(cat $b/status)" ;;
    *) echo "?" ;;
esac
