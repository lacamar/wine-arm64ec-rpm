+bool InvalidationTracker::HostPageHasUntrackedWritable(uint64_t HostBase) const {
+  const auto HostPageSize = FEXCore::Utils::GetHostPageSize();
+
+  for (uint64_t Page = HostBase; Page < HostBase + HostPageSize; Page += FEXCore::Utils::FEX_PAGE_SIZE) {
+    if (RWXIntervals.Query(Page).Enclosed) {
+      continue;
+    }
+    MEMORY_BASIC_INFORMATION Info;
+    if (NtQueryVirtualMemory(NtCurrentProcess(), reinterpret_cast<void*>(Page), MemoryBasicInformation, &Info, sizeof(Info), nullptr)) {
+      continue;
+    }
+    if (Info.State == MEM_COMMIT && ProtIsWritable(Info.Protect)) {
+      return true;
+    }
+  }
+  return false;
+}
