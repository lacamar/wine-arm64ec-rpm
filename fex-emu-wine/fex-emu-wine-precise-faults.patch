+void OpDispatchBuilder::RaiseDivideErrorIfZero(OpcodeArgs, Ref Divisor, IR::OpSize Size) {
+  // The host divide returns 0 for a zero divisor, Windows applications rely on the #DE exception instead.
+  if (CTX->HostFeatures.HostType != FEXCore::HostFeatures::HostTypeEnum::Wow64 &&
+      CTX->HostFeatures.HostType != FEXCore::HostFeatures::HostTypeEnum::Arm64ec) {
+    return;
+  }
+
+  CalculateDeferredFlags();
+
+  const auto CompareSize = Size == OpSize::i64Bit ? OpSize::i64Bit : OpSize::i32Bit;
+  auto CondJump_ = CondJump(Divisor, Constant(0), InvalidNode, InvalidNode, CondClass::NEQ, CompareSize);
+  auto TrapBlock = CreateNewCodeBlockAfter(GetCurrentBlock());
+  SetFalseJumpTarget(CondJump_, TrapBlock);
+  SetCurrentCodeBlock(TrapBlock);
+  StartNewBlock();
+
+  _StoreContextGPR(GetGPROpSize(), GetRelocatedPC(Op, -Op->InstSize), offsetof(FEXCore::Core::CPUState, rip));
+  Break(FEXCore::IR::BreakDefinition {
+    .ErrorRegister = 0,
+    .Signal = Core::FAULT_SIGSEGV,
+    .TrapNumber = X86State::X86_TRAPNO_DE,
+    .si_code = 0x80,
+  });
+
+  auto ContinueBlock = CreateNewCodeBlockAfter(TrapBlock);
+  SetTrueJumpTarget(CondJump_, ContinueBlock);
+  SetCurrentCodeBlock(ContinueBlock);
+  StartNewBlock();
+}
