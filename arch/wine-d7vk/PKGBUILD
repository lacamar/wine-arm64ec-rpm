source "$startdir/../wine-dxvk/PKGBUILD"
pkgbase=wine-d7vk
pkgname=(wine-d7vk)
pkgver=2.3
pkgrel=1
pkgdesc="Vulkan-based DirectDraw/D3D7 for Wine (copy x32/ddraw.dll next to the game)"
url=https://github.com/WinterSnowfall/d7vk
depends=(vulkan-icd-loader)
makedepends=(glslang meson)
_ext[0]='doitsujin/dxbc-spirv bf14419 subprojects/dxbc-spirv'
_archs=(i686)
_mesonargs+=(-Denable_dxgi=false -Denable_d3d11=false -Denable_d3d10=false -Denable_d3d8=false)
source=(https://github.com/WinterSnowfall/d7vk/archive/v$pkgver/d7vk-$pkgver.tar.gz
        https://github.com/bylaws/llvm-mingw/releases/download/20250920/$_mingw.tar.xz)
for _e in "${_ext[@]}"; do
  read -r _o _r _p <<<"$_e"
  source+=("${_o#*/}-$_r.tar.gz::https://github.com/$_o/archive/$_r.tar.gz")
done
package() {
  install -Dm644 $(find d7vk-$pkgver/build-i686/src/ddraw -name ddraw.dll) "$pkgdir"/usr/share/d7vk/x32/ddraw.dll
}
