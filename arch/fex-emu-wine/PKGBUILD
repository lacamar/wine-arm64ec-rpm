pkgname=fex-emu-wine
pkgver=2610
pkgrel=1
pkgdesc="FEX DLLs for enabling Wine's ARM64EC support"
arch=(aarch64)
url=https://fex-emu.com
license=(MIT Apache-2.0 BSD-3-Clause GPL-2.0-only)
makedepends=(clang cmake ninja python)
options=(!buildflags !lto !strip !debug)
_srcdir=FEX-FEX-$pkgver
_spec=fex-emu-wine-2610.spec
_mingw=llvm-mingw-20250920-ucrt-ubuntu-22.04-aarch64
_ext=(
  'Sonicadvance1/cpp-optparse 9f94388 ../Source/Common/cpp-optparse'
  'catchorg/Catch2 b3fb4b9 Catch2'
  'KhronosGroup/Vulkan-Headers ee2ec5f Vulkan-Headers'
  'FEX-Emu/drm-headers 3e49836 drm-headers'
  'fmtlib/fmt c07e2aa fmt'
  'FEX-Emu/jemalloc 8436195 jemalloc_glibc'
  'ericniebler/range-v3 ca1388f range-v3'
  'FEX-Emu/rpmalloc 09142d7 rpmalloc'
  'wolfpld/tracy 650c98e tracy'
  'martinus/unordered_dense 3234af2 unordered_dense'
  'FEX-Emu/vixl 585d860 vixl'
  'Cyan4973/xxHash e626a72 xxhash'
  'zyantific/zydis 9bfadd6 zydis'
)
source=(FEX-$pkgver.tar.gz::https://github.com/FEX-Emu/FEX/archive/FEX-$pkgver.tar.gz
        https://github.com/bylaws/llvm-mingw/releases/download/20250920/$_mingw.tar.xz)
for _e in "${_ext[@]}"; do
  read -r _o _r _p <<<"$_e"
  source+=("${_o#*/}-$_r.tar.gz::https://github.com/$_o/archive/$_r.tar.gz")
done

prepare() {
  cd $_srcdir
  local p o r d
  for p in $(sed -n 's/^Patch1[0-9][0-9]: *//p' "$startdir/../../fex-emu-wine/$_spec"); do
    patch -p1 -i "$startdir/../../fex-emu-wine/$p"
  done
  for p in "${_ext[@]}"; do
    read -r o r d <<<"$p"
    mkdir -p External/$d
    cp -a "$srcdir"/${o#*/}-$r*/. External/$d/
  done
}

_cmake() {
  mkdir -p build-$1 && cd build-$1
  cmake -GNinja -DCMAKE_C_FLAGS="$CFLAGS" -DCMAKE_CXX_FLAGS="$CFLAGS" \
    -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=/usr/lib/wine/aarch64-windows \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_TOOLCHAIN_FILE=../Data/CMake/toolchain_mingw.cmake \
    -DENABLE_LTO=False -DTUNE_CPU=none -DMINGW_TRIPLE=$1-w64-mingw32 -DBUILD_TESTING=False \
    -DENABLE_JEMALLOC_GLIBC_ALLOC=False -DCMAKE_POLICY_VERSION_MINIMUM=3.5 ..
  sed -i "s/$1-w64-mingw32-dlltool/llvm-dlltool -m $2/g" build.ninja
  ninja
  cd ..
}

build() {
  cd $_srcdir
  export CFLAGS="-O3 -g -pipe -Wall -Wextra" CXXFLAGS="-O3 -g -pipe -Wall -Wextra" LDFLAGS="-Wl,--gc-sections -static"
  PATH="$srcdir/$_mingw/bin:$PATH" _cmake arm64ec arm64ec
  PATH="$srcdir/$_mingw/bin:$PATH" _cmake aarch64 arm64
  mkdir -p build-unixlib && cd build-unixlib
  LDFLAGS="-Wl,--gc-sections" cmake -GNinja -DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++ \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=/usr/lib/wine/aarch64-unix \
    ../Source/Windows/UnixLib
  ninja
}

package() {
  cd $_srcdir
  local b
  for b in arm64ec aarch64 unixlib; do DESTDIR="$pkgdir" ninja -C build-$b install; done
  rm -rf "$pkgdir"/usr/{include,share}
}
