source "$startdir/../wine-dxvk/PKGBUILD"
pkgbase=wine-vkd3d-proton
pkgname=(wine-vkd3d-proton)
pkgver=3.0.1
pkgrel=6
pkgdesc="Vulkan-based D3D12 for Wine (ARM64EC)"
url=https://github.com/HansKristian-Work/vkd3d-proton
license=(LGPL-2.1-or-later MIT)
depends+=(wine-dxvk-dxgi)
_ext=(
  'KhronosGroup/SPIRV-Headers f88a2d7 khronos/SPIRV-Headers'
  'KhronosGroup/SPIRV-Headers f88a2d7 subprojects/dxil-spirv/third_party/spirv-headers'
  'KhronosGroup/Vulkan-Headers ad9ce12 khronos/Vulkan-Headers'
  'HansKristian-Work/dxil-spirv 62dbb07 subprojects/dxil-spirv'
  'doitsujin/dxbc-spirv 29c93ae subprojects/dxil-spirv/subprojects/dxbc-spirv'
  'KhronosGroup/SPIRV-Headers c8ad050 subprojects/dxil-spirv/subprojects/dxbc-spirv/submodules/spirv_headers'
)
_mesonargs=(-Denable_tests=false)
_cflags="-DNDEBUG -O2 -fno-lto"
_cxxflags=$_cflags
_ldflags="-Wl,--gc-sections -fno-lto"
source=(https://github.com/HansKristian-Work/vkd3d-proton/archive/v$pkgver/vkd3d-proton-$pkgver.tar.gz
        https://github.com/bylaws/llvm-mingw/releases/download/20250920/$_mingw.tar.xz)
for _e in "${_ext[@]}"; do
  read -r _o _r _p <<<"$_e"
  source+=("${_o#*/}-$_r.tar.gz::https://github.com/$_o/archive/$_r.tar.gz")
done
source=($(printf '%s\n' "${source[@]}" | awk '!s[$0]++'))
package() { _install d3d12 d3d12core; }
