+static WCHAR compose_wchar(struct xkb_compose_state *compose, xkb_keysym_t dead, xkb_keysym_t sym)
+{
+    char buf[8];
+    WCHAR wch[2];
+    int len;
+
+    xkb_compose_state_reset(compose);
+    xkb_compose_state_feed(compose, dead);
+    xkb_compose_state_feed(compose, sym);
+    if (xkb_compose_state_get_status(compose) != XKB_COMPOSE_COMPOSED) return 0;
+    if ((len = xkb_compose_state_get_utf8(compose, buf, sizeof(buf))) <= 0) return 0;
+    if (ntdll_umbstowcs(buf, len, wch, ARRAY_SIZE(wch)) != 1) return 0;
+    return wch[0];
+}
+
+static struct xkb_compose_state *create_compose_state(void)
+{
+    const char *locale = getenv("LC_ALL");
+    struct xkb_compose_table *table;
+    struct xkb_compose_state *compose;
+
+    if (!locale || !*locale) locale = getenv("LC_CTYPE");
+    if (!locale || !*locale) locale = getenv("LANG");
+    if (!locale || !*locale) locale = "C";
+    if (!(table = xkb_compose_table_new_from_locale(process_wayland.keyboard.xkb_context, locale, 0))) return NULL;
+    compose = xkb_compose_state_new(table, 0);
+    xkb_compose_table_unref(table);
+    return compose;
+}
+
+static void add_dead_keys(struct layout *layout, struct xkb_compose_state *compose,
+                          const xkb_keysym_t *dead_syms, const WCHAR *dead_chars, unsigned int dead_count)
+{
+    VK_TO_WCHARS8 *entry;
+    WCHAR bases[0x200];
+    unsigned int i, j, mod, base_count = 0;
+    DEADKEY *dead;
+
+    for (entry = layout->vk_to_wchars8; entry->VirtualKey; entry++)
+    {
+        if (entry->VirtualKey == 0xff) continue;
+        for (mod = 0; mod < 8; mod++)
+        {
+            WCHAR wch = entry->wch[mod];
+            if (wch == WCH_NONE || wch == WCH_DEAD || wch < 0x20) continue;
+            for (j = 0; j < base_count; j++) if (bases[j] == wch) break;
+            if (j == base_count && base_count < ARRAY_SIZE(bases)) bases[base_count++] = wch;
+        }
+    }
+
+    if (!(dead = layout->dead_keys = calloc(dead_count * (base_count + 1) + 1, sizeof(*dead)))) return;
+    for (i = 0; i < dead_count; i++)
+    {
+        dead->dwBoth = MAKELONG(' ', dead_chars[i]);
+        dead++->wchComposed = dead_chars[i];
+        for (j = 0; j < base_count; j++)
+        {
+            WCHAR wch = compose_wchar(compose, dead_syms[i], xkb_utf32_to_keysym(bases[j]));
+            if (!wch || bases[j] == ' ') continue;
+            dead->dwBoth = MAKELONG(bases[j], dead_chars[i]);
+            dead++->wchComposed = wch;
+        }
+    }
+    layout->tables.pDeadKey = layout->dead_keys;
+}
