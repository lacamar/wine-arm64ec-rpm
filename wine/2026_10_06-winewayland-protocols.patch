+/**********************************************************************
+ *          Wayland session
+ */
+
+static pthread_mutex_t session_mutex = PTHREAD_MUTEX_INITIALIZER;
+static struct xdg_session_v1 *xdg_session;
+static struct wl_list session_toplevels = {&session_toplevels, &session_toplevels};
+static BOOL session_replaced;
+
+static HKEY open_sessions_key(BOOL create)
+{
+    HKEY hkey;
+
+    if (create && (hkey = open_hkcu_key("Software\\Wine\\Wayland Driver", TRUE))) NtClose(hkey);
+    return open_hkcu_key("Software\\Wine\\Wayland Driver\\Sessions", create);
+}
+
+static BOOL load_session_id(char *id, ULONG size)
+{
+    UNICODE_STRING *name = &NtCurrentTeb()->Peb->ProcessParameters->ImagePathName;
+    char buffer[offsetof(KEY_VALUE_PARTIAL_INFORMATION, Data[256 * sizeof(WCHAR)])];
+    KEY_VALUE_PARTIAL_INFORMATION *info = (KEY_VALUE_PARTIAL_INFORMATION *)buffer;
+    BOOL ret = FALSE;
+    ULONG len;
+    HKEY hkey;
+
+    if (!(hkey = open_sessions_key(FALSE))) return FALSE;
+    if (!NtQueryValueKey(hkey, name, KeyValuePartialInformation, buffer, sizeof(buffer), &len) &&
+        info->Type == REG_SZ && info->DataLength > sizeof(WCHAR) &&
+        !RtlUnicodeToUTF8N(id, size - 1, &len, (WCHAR *)info->Data, info->DataLength - sizeof(WCHAR)))
+    {
+        id[len] = 0;
+        ret = TRUE;
+    }
+    NtClose(hkey);
+    return ret;
+}
+
+static void session_handle_created(void *data, struct xdg_session_v1 *session, const char *id)
+{
+    UNICODE_STRING *name = &NtCurrentTeb()->Peb->ProcessParameters->ImagePathName;
+    WCHAR idW[256];
+    ULONG len;
+    HKEY hkey;
+
+    TRACE("id=%s\n", debugstr_a(id));
+
+    if (RtlUTF8ToUnicodeN(idW, sizeof(idW) - sizeof(WCHAR), &len, id, strlen(id))) return;
+    idW[len / sizeof(WCHAR)] = 0;
+    if (!(hkey = open_sessions_key(TRUE))) return;
+    NtSetValueKey(hkey, name, 0, REG_SZ, idW, len + sizeof(WCHAR));
+    NtClose(hkey);
+}
+
+static void session_handle_restored(void *data, struct xdg_session_v1 *session)
+{
+    TRACE("\n");
+}
+
+static void session_handle_replaced(void *data, struct xdg_session_v1 *session)
+{
+    TRACE("\n");
+
+    pthread_mutex_lock(&session_mutex);
+    if (xdg_session == session)
+    {
+        xdg_session_v1_destroy(xdg_session);
+        xdg_session = NULL;
+        session_replaced = TRUE;
+    }
+    pthread_mutex_unlock(&session_mutex);
+}
+
+static const struct xdg_session_v1_listener session_listener =
+{
+    session_handle_created,
+    session_handle_restored,
+    session_handle_replaced,
+};
+
+static void toplevel_session_handle_restored(void *private, struct xdg_toplevel_session_v1 *toplevel_session)
+{
+    struct wayland_surface *surface;
+    struct wayland_win_data *data;
+    HWND hwnd = private;
+
+    TRACE("hwnd=%p\n", hwnd);
+
+    if (!(data = wayland_win_data_get(hwnd))) return;
+    if ((surface = data->wayland_surface) && wayland_surface_is_toplevel(surface) &&
+        surface->xdg_toplevel_session == toplevel_session)
+        surface->session_restored = TRUE;
+    wayland_win_data_release(data);
+}
+
+static const struct xdg_toplevel_session_v1_listener toplevel_session_listener =
+{
+    toplevel_session_handle_restored,
+};
+
+static BOOL session_name_in_use(const char *name)
+{
+    struct wayland_surface *surface;
+
+    wl_list_for_each(surface, &session_toplevels, session_link)
+        if (!strcmp(surface->session_name, name)) return TRUE;
+    return FALSE;
+}
+
+void wayland_session_add_toplevel(struct wayland_surface *surface)
+{
+    WCHAR classW[256];
+    UNICODE_STRING class = {0, sizeof(classW), classW};
+    char name[1024], id[256];
+    ULONG len;
+    int count, n;
+
+    if (!(count = NtUserGetClassName(surface->hwnd, FALSE, &class))) return;
+    if (RtlUnicodeToUTF8N(name, sizeof(name) - 16, &len, classW, count * sizeof(WCHAR))) return;
+    name[len] = 0;
+
+    if (process_wayland.xdg_toplevel_tag_manager_v1)
+        xdg_toplevel_tag_manager_v1_set_toplevel_tag(process_wayland.xdg_toplevel_tag_manager_v1,
+                                                     surface->xdg_toplevel, name);
+    if (!process_wayland.xdg_session_manager_v1) return;
+
+    pthread_mutex_lock(&session_mutex);
+
+    if (!xdg_session && !session_replaced)
+    {
+        xdg_session = xdg_session_manager_v1_get_session(process_wayland.xdg_session_manager_v1,
+                                                         XDG_SESSION_MANAGER_V1_REASON_LAUNCH,
+                                                         load_session_id(id, sizeof(id)) ? id : NULL);
+        xdg_session_v1_add_listener(xdg_session, &session_listener, NULL);
+    }
+
+    if (xdg_session)
+    {
+        for (n = 0;; n++)
+        {
+            if (n) snprintf(name + len, sizeof(name) - len, "#%d", n);
+            else name[len] = 0;
+            if (!session_name_in_use(name)) break;
+        }
+
+        TRACE("hwnd=%p name=%s\n", surface->hwnd, debugstr_a(name));
+        surface->session_name = strdup(name);
+        surface->xdg_toplevel_session =
+            xdg_session_v1_restore_toplevel(xdg_session, surface->xdg_toplevel, name);
+        xdg_toplevel_session_v1_add_listener(surface->xdg_toplevel_session,
+                                             &toplevel_session_listener, surface->hwnd);
+        wl_list_insert(&session_toplevels, &surface->session_link);
+    }
+
+    pthread_mutex_unlock(&session_mutex);
+}
+
+void wayland_session_remove_toplevel(struct wayland_surface *surface)
+{
+    if (!surface->xdg_toplevel_session) return;
+
+    pthread_mutex_lock(&session_mutex);
+    xdg_toplevel_session_v1_destroy(surface->xdg_toplevel_session);
+    surface->xdg_toplevel_session = NULL;
+    wl_list_remove(&surface->session_link);
+    free(surface->session_name);
+    surface->session_name = NULL;
+    surface->session_restored = FALSE;
+    pthread_mutex_unlock(&session_mutex);
+}
+
+void WAYLAND_Beep(void)
+{
+    if (!process_wayland.xdg_system_bell_v1) return;
+    xdg_system_bell_v1_ring(process_wayland.xdg_system_bell_v1, NULL);
+    wl_display_flush(process_wayland.wl_display);
+}
