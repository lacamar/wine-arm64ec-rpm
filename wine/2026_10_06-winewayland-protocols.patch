+<?xml version="1.0" encoding="UTF-8"?>
+<protocol name="pointer_gestures_unstable_v1">
+  <copyright>
+    Copyright © 2015, 2021 Red Hat Inc.
+
+    Permission to use, copy, modify, distribute, and sell this
