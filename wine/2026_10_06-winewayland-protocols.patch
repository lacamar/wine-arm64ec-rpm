+static void send_pinch_ctrl(HWND hwnd, BOOL up)
+{
+    INPUT input = {.type = INPUT_KEYBOARD};
+
+    input.ki.wScan = 0x1d;
+    input.ki.dwFlags = KEYEVENTF_SCANCODE | (up ? KEYEVENTF_KEYUP : 0);
+    NtUserSendHardwareInput(hwnd, 0, &input, 0);
+}
+
+static void pinch_begin(void *data, struct zwp_pointer_gesture_pinch_v1 *pinch,
+                        uint32_t serial, uint32_t time, struct wl_surface *surface,
+                        uint32_t fingers)
+{
+    struct wayland_pointer *pointer = &process_wayland.pointer;
+
+    pointer->pinch_scale = 1.0;
+    pointer->pinch_accum = 0.0;
+    pointer->pinch_ctrl = FALSE;
+}
+
+/* pinch zoom as Ctrl+wheel, as on Windows precision touchpads */
+static void pinch_update(void *data, struct zwp_pointer_gesture_pinch_v1 *pinch,
+                         uint32_t time, wl_fixed_t dx, wl_fixed_t dy,
+                         wl_fixed_t scale, wl_fixed_t rotation)
+{
+    struct wayland_pointer *pointer = &process_wayland.pointer;
+    double s = wl_fixed_to_double(scale);
+    INPUT input = {.type = INPUT_MOUSE};
+    HWND hwnd;
+    int delta;
+
+    if (s <= 0 || !(hwnd = wayland_pointer_get_focused_hwnd())) return;
+    pointer->pinch_accum += log(s / pointer->pinch_scale) * 4.33 * WHEEL_DELTA;
+    pointer->pinch_scale = s;
+    if (!(delta = pointer->pinch_accum)) return;
+
+    if (!pointer->pinch_ctrl && !(NtUserGetAsyncKeyState(VK_CONTROL) & 0x8000))
+    {
+        send_pinch_ctrl(hwnd, FALSE);
+        pointer->pinch_ctrl = TRUE;
+    }
+    input.mi.dwFlags = MOUSEEVENTF_WHEEL;
+    input.mi.mouseData = delta;
+    NtUserSendHardwareInput(hwnd, SEND_HWMSG_RAWINPUT, &input, 0);
+    pointer->pinch_accum -= delta;
+}
+
+static void pinch_end(void *data, struct zwp_pointer_gesture_pinch_v1 *pinch,
+                      uint32_t serial, uint32_t time, int32_t cancelled)
+{
+    struct wayland_pointer *pointer = &process_wayland.pointer;
+    HWND hwnd = wayland_pointer_get_focused_hwnd();
+
+    if (pointer->pinch_ctrl) send_pinch_ctrl(hwnd, TRUE);
+    pointer->pinch_ctrl = FALSE;
+}
+
+static const struct zwp_pointer_gesture_pinch_v1_listener pinch_listener =
+{
+    pinch_begin,
+    pinch_update,
+    pinch_end
+};
