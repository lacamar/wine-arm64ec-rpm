ntdll: Support ACPI firmware table enumeration.

EnumSystemFirmwareTables/GetSystemFirmwareTable("ACPI") read sysfs, with a minimal FADT fallback on hosts without ACPI tables.

---
--- a/dlls/ntdll/unix/system.c
+++ b/dlls/ntdll/unix/system.c
@@ -32,6 +32,7 @@
 #include <stdlib.h>
 #include <string.h>
 #include <sys/types.h>
+#include <sys/stat.h>
 #include <unistd.h>
 #include <errno.h>
 #include <sys/time.h>
@@ -2521,6 +2522,74 @@
 
 #endif
 
+#define ACPI_TABLES_DIR "/sys/firmware/acpi/tables"
+#define ACPI_FADT_SIZE 244
+
+static UINT acpi_sig( const char *name )
+{
+    UINT sig = 0;
+    int i;
+    for (i = 0; i < 4; i++) sig |= (UINT)(BYTE)name[i] << (i * 8);
+    return sig;
+}
+
+/* Hosts without readable ACPI tables (device-tree, or root-only sysfs) get a minimal FADT */
+static void fake_acpi_fadt( BYTE *buf )
+{
+    BYTE sum = 0;
+    UINT i;
+
+    memset( buf, 0, ACPI_FADT_SIZE );
+    memcpy( buf, "FACP", 4 );
+    *(UINT *)(buf + 4) = ACPI_FADT_SIZE;
+    buf[8] = 5;
+    memcpy( buf + 10, "WINE  ", 6 );
+    memcpy( buf + 16, "WINE    ", 8 );
+    *(UINT *)(buf + 24) = 1;
+    memcpy( buf + 28, "WINE", 4 );
+    *(UINT *)(buf + 32) = 1;
+    for (i = 0; i < ACPI_FADT_SIZE; i++) sum += buf[i];
+    buf[9] = -sum;
+}
+
+/* returns the table count; fills ids (up to max) or, with match != 0, reads the table into *data */
+static UINT scan_acpi_tables( UINT *ids, UINT max, UINT match, BYTE **data, ULONG *size )
+{
+    struct dirent *de;
+    UINT count = 0;
+    DIR *dir = opendir( ACPI_TABLES_DIR );
+
+    if (!dir) return 0;
+    while ((de = readdir( dir )))
+    {
+        char path[sizeof(ACPI_TABLES_DIR) + NAME_MAX + 2];
+        struct stat st;
+        int fd;
+
+        if (strlen( de->d_name ) < 4 || !strncmp( de->d_name, "..", 2 ) || de->d_name[0] == '.') continue;
+        snprintf( path, sizeof(path), ACPI_TABLES_DIR "/%s", de->d_name );
+        if ((fd = open( path, O_RDONLY )) == -1) continue;
+        if (!fstat( fd, &st ) && S_ISREG( st.st_mode ))
+        {
+            if (!match)
+            {
+                if (count < max) ids[count] = acpi_sig( de->d_name );
+                count++;
+            }
+            else if (acpi_sig( de->d_name ) == match && st.st_size > 0 && (*data = malloc( st.st_size )))
+            {
+                ssize_t n = read( fd, *data, st.st_size );
+                if (n > 0) { *size = n; count = 1; }
+                else { free( *data ); *data = NULL; }
+            }
+        }
+        close( fd );
+        if (match && count) break;
+    }
+    closedir( dir );
+    return count;
+}
+
 static NTSTATUS enum_firmware_info( SYSTEM_FIRMWARE_TABLE_INFORMATION *sfti, ULONG available_len,
                                     ULONG *required_len )
 {
@@ -2535,6 +2604,19 @@
         *(UINT *)sfti->TableBuffer = 0;
         return STATUS_SUCCESS;
 
+    case ACPI:
+    {
+        UINT count = scan_acpi_tables( NULL, 0, 0, NULL, NULL ), max;
+        if (!count) count = 1;
+        len = count * sizeof(UINT);
+        sfti->TableBufferLength = len;
+        *required_len = offsetof( SYSTEM_FIRMWARE_TABLE_INFORMATION, TableBuffer[len] );
+        if (available_len < *required_len) return STATUS_BUFFER_TOO_SMALL;
+        max = count;
+        if (!scan_acpi_tables( (UINT *)sfti->TableBuffer, max, 0, NULL, NULL )) *(UINT *)sfti->TableBuffer = acpi_sig( "FACP" );
+        return STATUS_SUCCESS;
+    }
+
     default:
         FIXME("info_class SYSTEM_FIRMWARE_TABLE_INFORMATION provider %08x\n", (unsigned int)sfti->ProviderSignature);
         return STATUS_NOT_IMPLEMENTED;
@@ -2545,6 +2627,7 @@
                                    ULONG *required_len )
 {
     static struct smbios_prologue *smbios_data;
+    NTSTATUS status = STATUS_SUCCESS;
     ULONG len;
 
     switch (sfti->ProviderSignature)
@@ -2563,6 +2646,26 @@
         memcpy( sfti->TableBuffer, smbios_data, len );
         return STATUS_SUCCESS;
 
+    case ACPI:
+    {
+        BYTE *data = NULL, fake[ACPI_FADT_SIZE];
+        ULONG size = 0;
+
+        if (!scan_acpi_tables( NULL, 0, sfti->TableID, &data, &size ))
+        {
+            if (sfti->TableID != acpi_sig( "FACP" ) || scan_acpi_tables( NULL, 0, 0, NULL, NULL )) return STATUS_NOT_FOUND;
+            fake_acpi_fadt( fake );
+            data = fake;
+            size = sizeof(fake);
+        }
+        sfti->TableBufferLength = size;
+        *required_len = offsetof( SYSTEM_FIRMWARE_TABLE_INFORMATION, TableBuffer[size] );
+        if (available_len < *required_len) status = STATUS_BUFFER_TOO_SMALL;
+        else memcpy( sfti->TableBuffer, data, size );
+        if (data != fake) free( data );
+        return status;
+    }
+
     default:
         FIXME("info_class SYSTEM_FIRMWARE_TABLE_INFORMATION provider %08x\n", (unsigned int)sfti->ProviderSignature);
         return STATUS_NOT_IMPLEMENTED;
