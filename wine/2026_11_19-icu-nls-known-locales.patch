icu: List only locales known to NLS.

.NET aborts CultureInfo.GetCultures on ICU locales GetLocaleInfoEx rejects
(en_US_POSIX, ibb, iu_CA, jv_Java, quc_GT, tzm_*).

--- a/dlls/icu/Makefile.in
+++ b/dlls/icu/Makefile.in
@@ -2,3 +2,6 @@
 IMPORTLIB = icu
 IMPORTS   = $(ICUI18N_PE_LIBS) $(ICUCOMMON_PE_LIBS) $(CXX_PE_LIBS) advapi32
 ENABLE_ARCHS = $(CXX_PE_ARCHS)
+
+SOURCES = \
+	icu.c
--- /dev/null
+++ b/dlls/icu/icu.c
@@ -0,0 +1,62 @@
