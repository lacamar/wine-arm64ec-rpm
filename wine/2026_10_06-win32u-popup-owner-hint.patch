win32u: hint popup owner from topmost overlapped window.

--- a/dlls/win32u/window.c
+++ b/dlls/win32u/window.c
@@ -2307,6 +2307,27 @@
            rect->top <= info->rcMonitor.top && rect->bottom >= info->rcMonitor.bottom;
 }
 
+static HWND get_owner_hint( HWND hwnd, const RECT *rect, struct ratio dpi )
+{
+    POINT pt = {rect->left - 1, rect->top - 1};
+    HWND owner, *list;
+    RECT tmp;
+    int i;
+
+    if ((owner = get_window_relative( hwnd, GW_OWNER ))) return NtUserGetAncestor( owner, GA_ROOT );
+    if (NtUserGetAncestor( hwnd, GA_PARENT ) != get_desktop_window()) return 0;
+    if (!(list = list_window_children( get_desktop_window() ))) return 0;
+    for (i = 0; list[i] && list[i] != hwnd; i++);
+    for (owner = 0; list[i] && (owner = list[++i]);)
+    {
+        if (!is_window_visible( owner ) || (get_window_long( owner, GWL_EXSTYLE ) & WS_EX_TRANSPARENT)) continue;
+        if (!get_window_rect( owner, &tmp, dpi )) continue;
+        if (PtInRect( &tmp, pt ) || intersect_rect( &tmp, &tmp, rect )) break;
+    }
+    free( list );
+    return owner;
+}
+
 /***********************************************************************
  *           apply_window_pos
  *
@@ -2486,10 +2507,7 @@
             user_driver->pSetWindowIcons( hwnd, icon, &ii, icon_small, &ii_small );
         }
 
-        owner_hint = NtUserGetWindowRelative(hwnd, GW_OWNER);
-        /* fallback to any window that is right below our top left corner */
-        if (!owner_hint) owner_hint = NtUserWindowFromPoint(new_rects->window.left - 1, new_rects->window.top - 1);
-        if (owner_hint) owner_hint = NtUserGetAncestor(owner_hint, GA_ROOT);
+        owner_hint = get_owner_hint( hwnd, &new_rects->window, dpi );
 
         user_driver->pWindowPosChanged( hwnd, insert_after, owner_hint, swp_flags, &monitor_rects,
                                         get_driver_window_surface( new_surface, raw_dpi ) );
