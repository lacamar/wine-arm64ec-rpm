--- a/dlls/winewayland.drv/appearance.c	2026-09-16 03:59:17.291164388 +0200
+++ b/dlls/winewayland.drv/appearance.c	2026-09-16 03:59:17.287164365 +0200
@@ -0,0 +1,247 @@
+/*
+ * Wayland host appearance (light/dark color scheme) integration
+ *
+ * Copyright 2026 Wine contributors
+ *
