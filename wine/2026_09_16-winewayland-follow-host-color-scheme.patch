diff --git a/dlls/winewayland.drv/appearance.c b/dlls/winewayland.drv/appearance.c
--- a/dlls/winewayland.drv/appearance.c
+++ b/dlls/winewayland.drv/appearance.c
@@ -0,0 +1,224 @@
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+
+#include "waylanddrv.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(waylanddrv);
+
+#ifdef SONAME_LIBDBUS_1
+
+#include <dlfcn.h>
+#include <dbus/dbus.h>
+
+#define DBUS_FUNCS \
+    DO_FUNC(dbus_bus_add_match); \
+    DO_FUNC(dbus_bus_get_private); \
+    DO_FUNC(dbus_connection_close); \
+    DO_FUNC(dbus_connection_flush); \
+    DO_FUNC(dbus_connection_pop_message); \
+    DO_FUNC(dbus_connection_read_write); \
+    DO_FUNC(dbus_connection_send_with_reply_and_block); \
+    DO_FUNC(dbus_connection_set_exit_on_disconnect); \
+    DO_FUNC(dbus_connection_unref); \
+    DO_FUNC(dbus_error_free); \
+    DO_FUNC(dbus_error_init); \
+    DO_FUNC(dbus_error_is_set); \
+    DO_FUNC(dbus_message_append_args); \
+    DO_FUNC(dbus_message_is_signal); \
+    DO_FUNC(dbus_message_iter_get_arg_type); \
+    DO_FUNC(dbus_message_iter_get_basic); \
+    DO_FUNC(dbus_message_iter_init); \
+    DO_FUNC(dbus_message_iter_next); \
+    DO_FUNC(dbus_message_iter_recurse); \
+    DO_FUNC(dbus_message_new_method_call); \
+    DO_FUNC(dbus_message_unref)
+
+#define DO_FUNC(f) static typeof(f) * p_##f
+DBUS_FUNCS;
+#undef DO_FUNC
+
+static const char appearance_namespace[] = "org.freedesktop.appearance";
+static const char color_scheme_key[] = "color-scheme";
+
+static DBusConnection *connection;
+static UINT host_scheme = WAYLAND_COLOR_SCHEME_NO_PREFERENCE;
+
+static BOOL load_dbus_functions(void)
+{
+    void *handle;
+
+    if (!(handle = dlopen(SONAME_LIBDBUS_1, RTLD_NOW))) goto failed;
+
+#define DO_FUNC(f) if (!(p_##f = dlsym(handle, #f))) goto failed
+    DBUS_FUNCS;
+#undef DO_FUNC
+
+    return TRUE;
+
+failed:
+    WARN("failed to load DBus support: %s\n", dlerror());
+    return FALSE;
+}
+
+static BOOL scheme_from_iter(DBusMessageIter *iter, UINT *scheme)
+{
+    while (p_dbus_message_iter_get_arg_type(iter) == DBUS_TYPE_VARIANT)
+    {
+        DBusMessageIter variant;
+        p_dbus_message_iter_recurse(iter, &variant);
+        *iter = variant;
+    }
+
+    if (p_dbus_message_iter_get_arg_type(iter) != DBUS_TYPE_UINT32) return FALSE;
+    p_dbus_message_iter_get_basic(iter, scheme);
+    return TRUE;
+}
+
+static BOOL read_color_scheme(const char *method, UINT *scheme)
+{
+    const char *namespace = appearance_namespace, *key = color_scheme_key;
+    DBusMessage *request, *reply;
+    DBusMessageIter iter;
+    DBusError error;
+    BOOL ret = FALSE;
+
+    if (!(request = p_dbus_message_new_method_call("org.freedesktop.portal.Desktop",
+                                                   "/org/freedesktop/portal/desktop",
+                                                   "org.freedesktop.portal.Settings",
+                                                   method)))
+        return FALSE;
+
+    p_dbus_message_append_args(request, DBUS_TYPE_STRING, &namespace,
+                               DBUS_TYPE_STRING, &key, DBUS_TYPE_INVALID);
+
+    p_dbus_error_init(&error);
+    reply = p_dbus_connection_send_with_reply_and_block(connection, request, 1000, &error);
+    p_dbus_message_unref(request);
+
+    if (!reply)
+    {
+        WARN("portal Settings.%s failed: %s\n", method, error.message);
+        p_dbus_error_free(&error);
+        return FALSE;
+    }
+    p_dbus_error_free(&error);
+
+    if (p_dbus_message_iter_init(reply, &iter)) ret = scheme_from_iter(&iter, scheme);
+    p_dbus_message_unref(reply);
+    return ret;
+}
+
+static BOOL appearance_connect(void)
+{
+    DBusError error;
+
+    if (!load_dbus_functions()) return FALSE;
+
+    p_dbus_error_init(&error);
+    connection = p_dbus_bus_get_private(DBUS_BUS_SESSION, &error);
+    if (!connection)
+    {
+        WARN("failed to connect to the session bus: %s\n", error.message);
+        p_dbus_error_free(&error);
+        return FALSE;
+    }
+    p_dbus_connection_set_exit_on_disconnect(connection, FALSE);
+
+    p_dbus_bus_add_match(connection,
+                         "type='signal',interface='org.freedesktop.portal.Settings',"
+                         "member='SettingChanged',arg0='org.freedesktop.appearance'",
+                         &error);
+    if (p_dbus_error_is_set(&error))
+    {
+        WARN("failed to watch portal setting changes: %s\n", error.message);
+        p_dbus_error_free(&error);
+        p_dbus_connection_close(connection);
+        p_dbus_connection_unref(connection);
+        connection = NULL;
+        return FALSE;
+    }
+    p_dbus_error_free(&error);
+    p_dbus_connection_flush(connection);
+
+    if (!read_color_scheme("ReadOne", &host_scheme) &&
+        !read_color_scheme("Read", &host_scheme))
+    {
+        p_dbus_connection_close(connection);
+        p_dbus_connection_unref(connection);
+        connection = NULL;
+        return FALSE;
+    }
+
+    TRACE("host color scheme is %u\n", host_scheme);
+    return TRUE;
+}
+
+static void handle_setting_changed(DBusMessage *message)
+{
+    DBusMessageIter iter;
+    const char *namespace, *key;
+    UINT scheme;
+
+    if (!p_dbus_message_iter_init(message, &iter)) return;
+    if (p_dbus_message_iter_get_arg_type(&iter) != DBUS_TYPE_STRING) return;
+    p_dbus_message_iter_get_basic(&iter, &namespace);
+    if (strcmp(namespace, appearance_namespace)) return;
+
+    if (!p_dbus_message_iter_next(&iter)) return;
+    if (p_dbus_message_iter_get_arg_type(&iter) != DBUS_TYPE_STRING) return;
+    p_dbus_message_iter_get_basic(&iter, &key);
+    if (strcmp(key, color_scheme_key)) return;
+
+    if (!p_dbus_message_iter_next(&iter)) return;
+    if (scheme_from_iter(&iter, &scheme)) host_scheme = scheme;
+}
+
+NTSTATUS WAYLAND_wait_color_scheme(void *arg)
+{
+    struct wait_color_scheme_params *params = arg;
+    static BOOL tried_connect;
+
+    if (!tried_connect)
+    {
+        tried_connect = TRUE;
+        if (!appearance_connect()) return STATUS_NOT_SUPPORTED;
+    }
+    if (!connection) return STATUS_NOT_SUPPORTED;
+
+    while (params->scheme == host_scheme)
+    {
+        DBusMessage *message;
+
+        if (!p_dbus_connection_read_write(connection, -1)) return STATUS_CONNECTION_DISCONNECTED;
+
+        while ((message = p_dbus_connection_pop_message(connection)))
+        {
+            if (p_dbus_message_is_signal(message, "org.freedesktop.portal.Settings", "SettingChanged"))
+                handle_setting_changed(message);
+            p_dbus_message_unref(message);
+        }
+    }
+
+    params->scheme = host_scheme;
+    return STATUS_SUCCESS;
+}
+
+#else
+
+NTSTATUS WAYLAND_wait_color_scheme(void *arg)
+{
+    return STATUS_NOT_SUPPORTED;
+}
+
+#endif
diff --git a/dlls/winewayland.drv/dllmain.c b/dlls/winewayland.drv/dllmain.c
--- a/dlls/winewayland.drv/dllmain.c
+++ b/dlls/winewayland.drv/dllmain.c
@@ -22,6 +22,7 @@
 
 #include "ntuser.h"
 #include "winuser.h"
+#include "winreg.h"
 
 #include "wine/debug.h"
 
@@ -93,6 +94,52 @@ static DWORD WINAPI clipboard_thread(void *arg)
     return 0;
 }
 
+static void apply_color_scheme(UINT scheme)
+{
+    DWORD light = scheme == WAYLAND_COLOR_SCHEME_DARK ? 0 : 1, old = ~0u, size = sizeof(old);
+    HKEY hkey;
+
+    if (RegCreateKeyExW(HKEY_CURRENT_USER,
+                        L"Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize",
+                        0, NULL, 0, KEY_QUERY_VALUE | KEY_SET_VALUE, NULL, &hkey, NULL))
+        return;
+
+    RegQueryValueExW(hkey, L"AppsUseLightTheme", NULL, NULL, (BYTE *)&old, &size);
+    RegSetValueExW(hkey, L"AppsUseLightTheme", 0, REG_DWORD, (BYTE *)&light, sizeof(light));
+    RegSetValueExW(hkey, L"SystemUsesLightTheme", 0, REG_DWORD, (BYTE *)&light, sizeof(light));
+    RegCloseKey(hkey);
+
+    TRACE("host color scheme %u -> AppsUseLightTheme %lu\n", scheme, light);
+
+    if (old == light) return;
+
+    SendMessageTimeoutW(HWND_BROADCAST, WM_SETTINGCHANGE, 0, (LPARAM)L"ImmersiveColorSet",
+                        SMTO_ABORTIFHUNG, 2000, NULL);
+    SendMessageTimeoutW(HWND_BROADCAST, WM_THEMECHANGED, 0, 0, SMTO_ABORTIFHUNG, 2000, NULL);
+}
+
+static DWORD WINAPI color_scheme_thread(void *arg)
+{
+    struct wait_color_scheme_params params = {.scheme = WAYLAND_COLOR_SCHEME_UNKNOWN};
+
+    while (!WAYLANDDRV_UNIX_CALL(wait_color_scheme, &params))
+        apply_color_scheme(params.scheme);
+
+    return 0;
+}
+
+static BOOL follow_system_color_scheme(void)
+{
+    WCHAR buffer[8];
+    DWORD size = sizeof(buffer);
+
+    if (RegGetValueW(HKEY_CURRENT_USER, L"Software\\Wine\\Wayland Driver",
+                     L"FollowSystemColorScheme", RRF_RT_REG_SZ, NULL, buffer, &size))
+        return TRUE;
+
+    return buffer[0] != 'n' && buffer[0] != 'N' && buffer[0] != '0';
+}
+
 BOOL WINAPI DllMain(HINSTANCE instance, DWORD reason, void *reserved)
 {
     DWORD tid;
@@ -110,6 +157,8 @@ BOOL WINAPI DllMain(HINSTANCE instance, DWORD reason, void *reserved)
     /* Handle clipboard events in a dedicated thread, if needed. */
     if (!WAYLANDDRV_UNIX_CALL(init_clipboard, NULL))
         CloseHandle(CreateThread(NULL, 0, clipboard_thread, NULL, 0, &tid));
+    if (follow_system_color_scheme())
+        CloseHandle(CreateThread(NULL, 0, color_scheme_thread, NULL, 0, &tid));
 
     return TRUE;
 }
