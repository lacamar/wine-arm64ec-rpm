+static BOOL get_output_rect(int index, RECT *rect)
+{
+    static const WCHAR prefix[] = {'\\','\\','.','\\','D','I','S','P','L','A','Y',0};
+    WCHAR name[32];
+    UNICODE_STRING device;
+    DEVMODEW mode = {.dmSize = sizeof(mode)};
+    int len = 0, n = index + 1;
+
+    while (prefix[len]) { name[len] = prefix[len]; len++; }
+    if (n >= 10) name[len++] = '0' + n / 10;
+    name[len++] = '0' + n % 10;
+    name[len] = 0;
+    device.Buffer = name;
+    device.Length = len * sizeof(WCHAR);
+    device.MaximumLength = sizeof(name);
+
+    if (!NtUserEnumDisplaySettings(&device, ENUM_CURRENT_SETTINGS, &mode, 0)) return FALSE;
+    SetRect(rect, mode.dmPosition.x, mode.dmPosition.y,
+            mode.dmPosition.x + mode.dmPelsWidth, mode.dmPosition.y + mode.dmPelsHeight);
+    return TRUE;
+}
+
+static BOOL rect_inside(const RECT *rect, const RECT *outer)
+{
+    RECT inter;
+    return intersect_rect(&inter, rect, outer) && EqualRect(&inter, rect);
+}
+
+/* output rects come from the display settings, in the same raw coordinates as the driver's window rects */
+static BOOL get_current_output_rect(const RECT *window, RECT *best)
+{
+    RECT rect, inter;
+    LONG score, best_score = LONG_MIN, dx, dy;
+    int i;
+
+    for (i = 0; get_output_rect(i, &rect); i++)
+    {
+        if (intersect_rect(&inter, window, &rect))
+            score = (inter.right - inter.left) * (inter.bottom - inter.top);
+        else
+        {
+            dx = max(0, max(rect.left - window->right, window->left - rect.right));
+            dy = max(0, max(rect.top - window->bottom, window->top - rect.bottom));
+            score = -(dx + dy);
+        }
+        if (score > best_score)
+        {
+            best_score = score;
+            *best = rect;
+        }
+    }
+    return best_score != LONG_MIN;
+}
+
+static void wayland_window_follow_output(HWND hwnd, int index)
+{
+    struct wayland_win_data *data;
+    RECT target, window, current;
+    BOOL toplevel;
+    UINT flags = SWP_NOZORDER | SWP_NOACTIVATE | SWP_NOOWNERZORDER;
+
+    if (!get_output_rect(index, &target)) return;
+
+    if (!(data = wayland_win_data_get(hwnd))) return;
+    window = data->rects.window;
+    toplevel = data->wayland_surface && wayland_surface_is_toplevel(data->wayland_surface);
+    if (toplevel)
+    {
+        if (data->output_index != index) data->output_follow_count = 0;
+        data->output_index = index;
+        if (NtGetTickCount() - data->output_follow_time > 2000) data->output_follow_count = 0;
+        if (data->output_follow_count >= 3) toplevel = FALSE;
+        else
+        {
+            data->output_follow_time = NtGetTickCount();
+            data->output_follow_count++;
+        }
+    }
+    wayland_win_data_release(data);
+
+    if (!toplevel || IsRectEmpty(&window)) return;
+    if (rect_inside(&window, &target)) return;
+
+    if (!get_current_output_rect(&window, &current)) return;
+
+    if (EqualRect(&window, &current)) window = target;
+    else
+    {
+        OffsetRect(&window, target.left - current.left, target.top - current.top);
+        flags |= SWP_NOSIZE;
+    }
+
+    TRACE("hwnd=%p -> %s on DISPLAY%d\n", hwnd, wine_dbgstr_rect(&window), index + 1);
+    NtUserSetRawWindowPos(hwnd, window, flags, FALSE);
+}
