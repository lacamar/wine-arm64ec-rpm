+static void surface_handle_enter(void *data, struct wl_surface *wl_surface,
+                                 struct wl_output *wl_output)
+{
+    HWND hwnd = wl_surface_get_user_data(wl_surface);
+    struct wayland_output *output = wl_output ? wl_output_get_user_data(wl_output) : NULL;
+    int index;
+
+    if (!hwnd || !output) return;
+
+    pthread_mutex_lock(&process_wayland.output_mutex);
+    index = wayland_output_win32_index(output);
+    pthread_mutex_unlock(&process_wayland.output_mutex);
+
+    TRACE("hwnd=%p output=%s index=%d\n", hwnd, output->current.name, index);
+
+    if (index >= 0) NtUserPostMessage(hwnd, WM_WAYLAND_OUTPUT_ENTER, 0, index);
+}
