+static struct wayland_surface *get_owner_toplevel(HWND hwnd)
+{
+    struct wayland_surface *surface = NULL;
+    struct wayland_win_data *data;
+    HWND owner;
+
+    if (!(owner = NtUserGetWindowRelative(hwnd, GW_OWNER)) || !(data = wayland_win_data_get(owner))) return NULL;
