+static BOOL sample_has_dxgi_buffer(IMFSample *sample)
+{
+    IMFMediaBuffer *buffer;
+    IMFDXGIBuffer *dxgi;
+    BOOL ret = FALSE;
+
+    if (SUCCEEDED(IMFSample_GetBufferByIndex(sample, 0, &buffer)))
+    {
+        if ((ret = SUCCEEDED(IMFMediaBuffer_QueryInterface(buffer, &IID_IMFDXGIBuffer, (void **)&dxgi))))
+            IMFDXGIBuffer_Release(dxgi);
+        IMFMediaBuffer_Release(buffer);
+    }
+
+    return ret;
+}
