@@ -752,13 +752,44 @@ static BOOL wayland_surface_reconfigure_xdg(struct wayland_surface *surface, REC
     return TRUE;
 }
 
+static void wayland_surface_restack_subsurface(struct wayland_surface *surface,
+                                               struct wayland_win_data *owner_data)
+{
+    struct wayland_surface *owner_surface = owner_data->wayland_surface;
+    struct wl_surface *below = NULL;
+    HWND hwnd = surface->hwnd;
+
+    if (!surface->wl_subsurface || !owner_surface) return;
+
+    while ((hwnd = NtUserGetWindowRelative(hwnd, GW_HWNDNEXT)) && hwnd != surface->owner_hwnd)
+    {
+        struct wayland_win_data *sibling_data;
+        struct wayland_surface *sibling;
+
+        if (!(sibling_data = wayland_win_data_get(hwnd))) continue;
+        if ((sibling = sibling_data->wayland_surface) && sibling->wl_subsurface &&
+            sibling->owner_hwnd == surface->owner_hwnd)
+            below = sibling->wl_surface;
+        wayland_win_data_release(sibling_data);
+        if (below) break;
+    }
+
+    if (!below && owner_data->client_surface && owner_data->client_surface->wl_subsurface)
+        below = owner_data->client_surface->wl_surface;
+    if (!below) below = owner_surface->wl_surface;
+
+    TRACE("hwnd=%p above wl_surface=%p (hwnd=%p)\n", surface->hwnd, below, hwnd);
+
+    wl_subsurface_place_above(surface->wl_subsurface, below);
+}
+
 /**********************************************************************
  *          wayland_surface_reconfigure_subsurface
  *
  * Reconfigures the subsurface as needed to match the latest requested
  * state.
  */
-static void wayland_surface_reconfigure_subsurface(struct wayland_surface *surface)
+void wayland_surface_reconfigure_subsurface(struct wayland_surface *surface)
 {
     struct wayland_win_data *owner_data;
     struct wayland_surface *owner_surface;
@@ -776,10 +807,7 @@ static void wayland_surface_reconfigure_subsurface(struct wayland_surface *surfa
         TRACE("hwnd=%p rect=%s\n", surface->hwnd, wine_dbgstr_rect(&rect));
 
         wl_subsurface_set_position(surface->wl_subsurface, rect.left, rect.top);
-        if (owner_data->client_surface && owner_data->client_surface->wl_subsurface)
-            wl_subsurface_place_above(surface->wl_subsurface, owner_data->client_surface->wl_surface);
-        else
-            wl_subsurface_place_above(surface->wl_subsurface, owner_surface->wl_surface);
+        wayland_surface_restack_subsurface(surface, owner_data);
         wl_surface_commit(owner_surface->wl_surface);
 
         memset(&surface->processing, 0, sizeof(surface->processing));
