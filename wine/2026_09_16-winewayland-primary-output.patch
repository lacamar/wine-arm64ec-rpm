winewayland: add a PrimaryOutput setting.

diff --git a/dlls/winewayland.drv/display.c b/dlls/winewayland.drv/display.c
--- a/dlls/winewayland.drv/display.c
+++ b/dlls/winewayland.drv/display.c
@@ -45,8 +45,17 @@ static int output_info_cmp_primary_x_y(const void *va, const void *vb)
 {
     const struct output_info *a = va;
     const struct output_info *b = vb;
-    BOOL a_is_primary = a->x == 0 && a->y == 0;
-    BOOL b_is_primary = b->x == 0 && b->y == 0;
+    BOOL a_is_primary, b_is_primary;
+
+    if (primary_output_name[0])
+    {
+        a_is_primary = !strcmp(a->output->name, primary_output_name);
+        b_is_primary = !strcmp(b->output->name, primary_output_name);
+        if (a_is_primary != b_is_primary) return a_is_primary ? -1 : 1;
+    }
+
+    a_is_primary = a->x == 0 && a->y == 0;
+    b_is_primary = b->x == 0 && b->y == 0;
 
     if (a_is_primary && !b_is_primary) return -1;
     if (!a_is_primary && b_is_primary) return 1;
