--- a/dlls/winewayland.drv/waylanddrv_main.c
+++ b/dlls/winewayland.drv/waylanddrv_main.c
@@ -33,6 +33,7 @@
 
 char *process_name = NULL;
 BOOL host_decorations = FALSE;
+char primary_output_name[64] = {0};
 
 static const struct user_driver_funcs waylanddrv_funcs =
 {
@@ -123,6 +124,8 @@ static HKEY open_hkcu_key(const char *name)
     return reg_open_key(NULL, bufferW, len * sizeof(WCHAR));
 }
 
+static void wayland_init_primary_output(void);
+
 static void wayland_init_options(void)
 {
     static const WCHAR decoratedW[] = {'D','e','c','o','r','a','t','e','d'};
@@ -141,6 +144,31 @@ static void wayland_init_options(void)
         host_decorations = ch == 'y' || ch == 'Y' || ch == 't' || ch == 'T' || ch == '1';
     }
     NtClose(hkey);
+
+    wayland_init_primary_output();
+}
+
+static void wayland_init_primary_output(void)
+{
+    static const WCHAR primaryW[] = {'P','r','i','m','a','r','y','O','u','t','p','u','t'};
+    UNICODE_STRING nameW = { sizeof(primaryW), sizeof(primaryW), (WCHAR *)primaryW };
+    char buffer[offsetof(KEY_VALUE_PARTIAL_INFORMATION, Data[sizeof(primary_output_name) * sizeof(WCHAR)])];
+    KEY_VALUE_PARTIAL_INFORMATION *info = (KEY_VALUE_PARTIAL_INFORMATION *)buffer;
+    ULONG size;
+    HKEY hkey;
+
+    if (!(hkey = open_hkcu_key("Software\\Wine\\Wayland Driver"))) return;
+    if (!NtQueryValueKey(hkey, &nameW, KeyValuePartialInformation, buffer, sizeof(buffer), &size) &&
+        info->Type == REG_SZ)
+    {
+        const WCHAR *value = (const WCHAR *)info->Data;
+        ULONG i, len = info->DataLength / sizeof(WCHAR);
+
+        if (len >= sizeof(primary_output_name)) len = sizeof(primary_output_name) - 1;
+        for (i = 0; i < len && value[i]; i++) primary_output_name[i] = value[i];
+        primary_output_name[i] = 0;
+    }
+    NtClose(hkey);
 }
 
 static NTSTATUS waylanddrv_unix_init(void *arg)
