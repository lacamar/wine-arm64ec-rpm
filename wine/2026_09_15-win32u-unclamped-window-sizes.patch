+/* Since Windows 7 only top-level window positions are limited to 16 bits; sizes and child
+ * positions are not, and applications scroll huge child windows (e.g. Lightroom's grid). */
+static void clamp_winpos( WINDOWPOS *winpos, BOOL child, UINT flags )
+{
+    if (!(flags & SWP_NOMOVE) && !child)
+    {
+        if (winpos->x < -32768) winpos->x = -32768;
+        else if (winpos->x > 32767) winpos->x = 32767;
+        if (winpos->y < -32768) winpos->y = -32768;
+        else if (winpos->y > 32767) winpos->y = 32767;
+    }
+    if (!(flags & SWP_NOSIZE))
+    {
+        if (winpos->cx < 0) winpos->cx = 0;
+        else if ((LONGLONG)winpos->x + winpos->cx > INT_MAX) winpos->cx = INT_MAX - max( winpos->x, 0 );
+        if (winpos->cy < 0) winpos->cy = 0;
+        else if ((LONGLONG)winpos->y + winpos->cy > INT_MAX) winpos->cy = INT_MAX - max( winpos->y, 0 );
+    }
+}
