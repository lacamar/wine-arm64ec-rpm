win32u: only EndPaint may release a BeginPaint DC.

diff --git a/dlls/win32u/dce.c b/dlls/win32u/dce.c
--- a/dlls/win32u/dce.c
+++ b/dlls/win32u/dce.c
@@ -43,6 +43,7 @@ struct dce
     UINT        flags;
     LONG        count;         /* usage count; 0 or 1 for cache DCEs, always 1 for window DCEs,
                                   always >= 1 for class DCEs */
+    BOOL        in_paint;
 };
 
 static struct list dce_list = LIST_INIT(dce_list);
@@ -1235,10 +1236,12 @@ static INT release_dc( HWND hwnd, HDC hdc, BOOL end_paint )
 
     user_lock();
     dce = get_dc_dce( hdc );
+    if (dce && dce->in_paint && !end_paint) dce = NULL;
     if (dce && dce->count && dce->hwnd)
     {
         if (!(dce->flags & DCX_NORESETATTRS)) set_dce_flags( dce->hdc, DCHF_RESETDC );
         if (end_paint || (dce->flags & DCX_CACHE)) delete_clip_rgn( dce );
+        dce->in_paint = FALSE;
         if (dce->flags & DCX_CACHE)
         {
             dce->count = 0;
@@ -1386,6 +1389,7 @@ HDC WINAPI NtUserGetDCEx( HWND hwnd, HRGN clip_rgn, DWORD flags )
 
     dce->hwnd = hwnd;
     dce->flags = (dce->flags & ~user_flags) | (flags & user_flags);
+    dce->in_paint = FALSE;
 
     /* cross-process invalidation is not supported yet, so always update the vis rgn */
     if (!is_current_process_window( hwnd )) update_vis_rgn = TRUE;
@@ -1706,6 +1710,7 @@ void move_window_bits_surface( HWND hwnd, const RECT *window_rect, struct window
  */
 HDC WINAPI NtUserBeginPaint( HWND hwnd, PAINTSTRUCT *ps )
 {
+    struct dce *dce;
     HRGN hrgn;
     HDC hdc;
     BOOL erase;
@@ -1728,6 +1733,11 @@ HDC WINAPI NtUserBeginPaint( HWND hwnd, PAINTSTRUCT *ps )
     ps->fErase = erase;
     ps->rcPaint = rect;
     ps->hdc = hdc;
+
+    user_lock();
+    if ((dce = get_dc_dce( hdc ))) dce->in_paint = TRUE;
+    user_unlock();
+
     return hdc;
 }
 
